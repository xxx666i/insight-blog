---
interface Props {
  title?: string;
  tone?: 'note' | 'tip' | 'warning';
}
const { title = '说明', tone = 'note' } = Astro.props;
---

<aside class:list={['callout', `callout-${tone}`]}>
  <p>{title}</p>
  <div><slot /></div>
</aside>

<style>
  .callout { margin: 2em 0; padding: 18px 20px; border: 1px solid var(--color-border); border-left: 2px solid var(--color-info); border-radius: var(--radius-lg); background: var(--color-bg-subtle); }
  .callout > p { margin: 0 0 5px; color: var(--color-info); font-family: var(--font-sans); font-size: var(--text-label-12); font-weight: 500; }
  .callout :global(p) { margin: 0; }
  .callout-tip { border-left-color: var(--color-success); }
  .callout-tip > p { color: var(--color-success); }
  .callout-warning { border-left-color: var(--color-warning); }
  .callout-warning > p { color: var(--color-warning); }
</style>
