---
import { navigation, siteConfig } from '../config';
import { withBase } from '../lib/url';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath.startsWith(withBase(href));
---

<header class="site-header">
  <div class="header-inner page-shell">
    <a class="wordmark" href={withBase('/')} aria-label={`${siteConfig.name} 首页`}>
      <span class="wordmark-letter">D</span><span class="wordmark-dot" aria-hidden="true"></span><span class="wordmark-rest">uDuLu</span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="icon-button search-trigger" type="button" aria-label="打开搜索" title="搜索（Ctrl/⌘ K）">
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      </button>
      <button class="icon-button theme-toggle" type="button" aria-label="切换主题" title="切换主题">
        <span class="theme-glyph" aria-hidden="true">◐</span>
      </button>
      <details class="mobile-menu">
        <summary aria-label="打开导航"><span></span><span></span></summary>
        <nav aria-label="移动端导航">
          {navigation.map((item) => (
            <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const media = matchMedia('(prefers-color-scheme: dark)');
  const labels = { system: '跟随系统', light: '浅色', dark: '深色' } as const;

  function applyTheme(preference: keyof typeof labels) {
    const resolved = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
    root.dataset.themePreference = preference;
    root.dataset.theme = resolved;
    if (themeButton) {
      themeButton.dataset.preference = preference;
      themeButton.setAttribute('aria-label', `当前：${labels[preference]}。点击切换主题`);
      themeButton.title = `主题：${labels[preference]}`;
    }
  }

  applyTheme((localStorage.getItem('dudulu-theme') as keyof typeof labels) || 'system');

  themeButton?.addEventListener('click', () => {
    const current = (root.dataset.themePreference || 'system') as keyof typeof labels;
    const next = current === 'system' ? 'light' : current === 'light' ? 'dark' : 'system';
    localStorage.setItem('dudulu-theme', next);
    applyTheme(next);
  });

  media.addEventListener('change', () => {
    if (root.dataset.themePreference === 'system') applyTheme('system');
  });

  document.querySelectorAll<HTMLAnchorElement>('.mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-height);
    border-bottom: 1px solid color-mix(in srgb, var(--ring) 68%, transparent);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(18px) saturate(120%);
  }
  .header-inner { display: flex; height: 100%; align-items: center; }
  .wordmark { display: inline-flex; align-items: baseline; margin-right: auto; color: var(--n-10); text-decoration: none; }
  .wordmark-letter, .wordmark-rest { font-family: var(--font-serif); font-size: 21px; font-weight: 500; letter-spacing: -.055em; }
  .wordmark-dot { width: 5px; height: 5px; margin: 0 1px 10px -1px; border-radius: 50%; background: var(--ume); }
  .desktop-nav { display: flex; align-items: center; gap: 30px; margin-right: 28px; }
  .desktop-nav a { position: relative; color: var(--n-6); font-size: 13px; text-decoration: none; }
  .desktop-nav a:hover, .desktop-nav a[aria-current='page'] { color: var(--n-10); }
  .desktop-nav a[aria-current='page']::after { position: absolute; right: 0; bottom: -23px; left: 0; height: 1px; background: var(--ume); content: ''; }
  .header-actions { display: flex; align-items: center; gap: 5px; }
  .icon-button { display: grid; width: 34px; height: 34px; padding: 0; place-items: center; border: 0; border-radius: 50%; color: var(--n-6); background: transparent; cursor: pointer; }
  .icon-button:hover { color: var(--n-10); background: var(--n-1); }
  .icon-button svg { width: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .theme-glyph { font-family: var(--font-mono); font-size: 17px; transform: rotate(-18deg); }
  .theme-toggle[data-preference='light'] .theme-glyph { transform: rotate(0); }
  .theme-toggle[data-preference='dark'] .theme-glyph { transform: rotate(180deg); }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { display: grid; width: 34px; height: 34px; padding: 9px; place-content: center; gap: 5px; border-radius: 50%; cursor: pointer; list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary span { width: 16px; height: 1px; background: currentColor; transition: transform 160ms ease; }
  .mobile-menu[open] summary span:first-child { transform: translateY(3px) rotate(45deg); }
  .mobile-menu[open] summary span:last-child { transform: translateY(-3px) rotate(-45deg); }
  .mobile-menu nav { position: absolute; top: 44px; right: 0; width: 180px; padding: 8px; border: 1px solid var(--ring); border-radius: 10px; background: var(--paper-raised); box-shadow: var(--shadow); }
  .mobile-menu nav a { display: block; padding: 10px 12px; border-radius: 6px; color: var(--n-7); font-size: 14px; text-decoration: none; }
  .mobile-menu nav a:hover, .mobile-menu nav a[aria-current='page'] { color: var(--ume-ink); background: var(--ume-soft); }
  @media (max-width: 760px) {
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
  }
</style>
