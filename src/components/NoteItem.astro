---
import type { CollectionEntry } from 'astro:content';
import { excerpt, formatDate, plainText } from '../lib/content';
import { withBase } from '../lib/url';
import TagList from './TagList.astro';

interface Props {
  note: CollectionEntry<'notes'>;
  compact?: boolean;
}

const { note, compact = false } = Astro.props;
const text = compact ? excerpt(note.body, 115) : plainText(note.body);
---

<article class:list={['note-item', { compact }]}>
  <div class="note-date">
    <time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt)}</time>
    <span aria-hidden="true"></span>
  </div>
  <div class="note-copy">
    {note.data.title && <h3><a href={withBase(`notes/${note.id}/`)}>{note.data.title}</a></h3>}
    <p>{text}</p>
    <div class="note-footer">
      <TagList tags={note.data.tags} />
      <a class="permalink" href={withBase(`notes/${note.id}/`)} aria-label={note.data.title ? `打开随记《${note.data.title}》` : '打开这条随记'}>永久链接 ↗</a>
    </div>
  </div>
</article>

<style>
  .note-item { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: clamp(24px, 5vw, 68px); padding: 30px 0 34px; border-bottom: 1px solid var(--ring); }
  .note-date { display: flex; align-items: center; gap: 12px; padding-top: 5px; color: var(--n-5); font-family: var(--font-mono); font-size: 10px; white-space: nowrap; }
  .note-date span { width: 20px; height: 1px; background: var(--n-3); }
  .note-copy h3 { margin: 0 0 7px; font-family: var(--font-sans); font-size: 16px; font-weight: 500; }
  .note-copy h3 a { text-decoration: none; }
  .note-copy > p { max-width: 680px; margin: 0; color: var(--n-8); font-size: 14px; line-height: 1.9; white-space: pre-line; }
  .note-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 18px; }
  .permalink { flex: none; color: var(--n-5); font-family: var(--font-mono); font-size: 9px; letter-spacing: .05em; text-decoration: none; }
  .permalink:hover { color: var(--ume-ink); }
  .compact { grid-template-columns: 100px minmax(0, 1fr); padding-block: 24px; }
  @media (max-width: 620px) {
    .note-item, .compact { grid-template-columns: 1fr; gap: 10px; }
    .note-date span { width: 30px; }
  }
</style>
