---
import type { CollectionEntry } from 'astro:content';
import { excerpt, formatDate, plainText } from '../lib/content';
import { withBase } from '../lib/url';
import TagList from './TagList.astro';

interface Props {
  note: CollectionEntry<'notes'>;
  compact?: boolean;
  showTags?: boolean;
  wide?: boolean;
}

const { note, compact = false, showTags = true, wide = false } = Astro.props;
const text = compact ? excerpt(note.body, 115) : plainText(note.body);
const href = withBase(`notes/${note.id}/`);
---

<article class:list={['note-item', { compact, wide }]}>
  <div class="note-date">
    <time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt)}</time>
    <span aria-hidden="true"></span>
  </div>
  <div class="note-copy">
    {note.data.title ? (
      <h3><a class="note-primary-link" href={href}>{note.data.title}</a></h3>
    ) : (
      <a class="note-primary-link untitled-link" href={href} aria-label="阅读这条无题随记"></a>
    )}
    <p>{text}</p>
    {showTags && <TagList tags={note.data.tags} />}
  </div>
</article>

<style>
  .note-item { position: relative; display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: var(--space-6); padding: 28px 0 30px; border-bottom: 1px solid var(--color-border); transition: background var(--duration-fast) var(--ease-standard); }
  .note-date { display: flex; align-items: center; gap: var(--space-3); padding-top: 5px; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: var(--text-label-12); line-height: var(--text-label-12--line-height); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .note-date span { width: var(--space-5); height: 1px; background: var(--color-border); }
  .note-copy h3 { margin: 0 0 var(--space-2); color: var(--color-text-heading); font-family: var(--font-serif); font-size: var(--text-title-20); font-weight: 500; line-height: var(--text-title-20--line-height); }
  .note-primary-link { text-decoration: none; background: linear-gradient(var(--color-text-interactive), var(--color-text-interactive)) 0 100% / 0 1px no-repeat; transition: color var(--duration-fast) var(--ease-standard), background-size 220ms var(--ease-standard); }
  .note-primary-link::after { position: absolute; inset: 0; content: ''; }
  .note-primary-link:focus-visible { outline: 0; }
  .untitled-link { display: block; height: 0; }
  .note-item:hover .note-primary-link, .note-primary-link:focus-visible { color: var(--color-text-interactive); background-size: 100% 1px; }
  .note-item:has(.note-primary-link:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .note-copy > p { max-width: 680px; margin: 0; color: var(--color-text-strong-secondary); font-size: var(--text-copy-14); line-height: 1.75; white-space: pre-line; transition: color var(--duration-fast) var(--ease-standard); }
  .note-item:has(.untitled-link):hover .note-copy > p,
  .note-item:has(.untitled-link:focus-visible) .note-copy > p { color: var(--color-text-interactive); }
  .wide .note-copy > p { max-width: 900px; font-size: var(--text-copy-15); line-height: 1.8; }
  .note-copy :global(.tag-list) { position: relative; z-index: 1; width: fit-content; margin-top: var(--space-4); }
  .compact { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 24px 0 25px var(--space-5); }
  .compact::before { position: absolute; top: 25px; bottom: 25px; left: 0; width: 1px; background: var(--color-border); content: ''; transition: background var(--duration-fast) var(--ease-standard); }
  .compact:hover::before { background: var(--color-text-interactive); }
  .compact .note-copy { grid-row: 1; }
  .compact .note-date { grid-row: 2; margin-top: var(--space-3); padding-top: 0; }
  .compact .note-date span { display: none; }
  .compact .note-copy > p { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
  @media (max-width: 620px) {
    .note-item { grid-template-columns: 1fr; gap: var(--space-2); }
    .compact { gap: 0; }
    .note-date span { width: 30px; }
  }
</style>
