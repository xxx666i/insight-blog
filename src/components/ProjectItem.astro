---
import type { CollectionEntry } from 'astro:content';
import { projectStatus } from '../config';
import { withBase } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const href = project.data.externalUrl || withBase(`projects/${project.id}/`);
const external = Boolean(project.data.externalUrl);
---

<article class="project-item">
  <span class="project-number" aria-hidden="true">P.{String(index + 1).padStart(2, '0')}</span>
  <div>
    <p class="project-status"><span></span>{projectStatus[project.data.status]}</p>
    <h3>
      <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
        {project.data.title}
        {external && <svg class="external-mark" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3h7v7M13 3 5 11"></path><path d="M11 9v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h3"></path></svg>}
      </a>
    </h3>
    <p class="project-summary">{project.data.summary}</p>
    <p class="project-tech">{project.data.technologies.join(' / ')}</p>
  </div>
</article>

<style>
  .project-item { position: relative; display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 18px; min-height: 220px; padding: 24px; border: 1px solid var(--ring); border-radius: 8px; background: color-mix(in srgb, var(--n-1) 62%, transparent); transition: border-color 180ms ease, transform 180ms ease, background 180ms ease, box-shadow 180ms ease; }
  .project-item:hover { border-color: color-mix(in srgb, var(--ume) 45%, var(--ring)); background: var(--paper-raised); box-shadow: var(--shadow); transform: translateY(-2px); }
  .project-number { color: var(--n-7); font-family: var(--font-mono); font-size: var(--text-label-12); font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .project-status { display: flex; align-items: center; gap: 8px; margin: 0 0 28px; color: var(--n-7); font-family: var(--font-mono); font-size: var(--text-label-12); letter-spacing: .04em; }
  .project-status span { width: 5px; height: 5px; border-radius: 50%; background: var(--ume); }
  h3 { margin: 0 0 9px; color: var(--n-10); font-family: var(--font-serif); font-size: var(--text-title-24); font-weight: 500; line-height: 1.2; }
  h3 a { display: inline-flex; align-items: baseline; gap: var(--space-2); text-decoration: none; transition: color var(--duration-fast) var(--ease-standard); }
  h3 a::after { position: absolute; inset: 0; content: ''; }
  h3 a:focus-visible { outline: 0; }
  .project-item:hover h3 a, h3 a:focus-visible { color: var(--color-text-interactive); }
  .project-item:has(h3 a:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .external-mark { width: var(--text-icon-sm); height: var(--text-icon-sm); flex: 0 0 auto; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.25; }
  .project-summary { max-width: 430px; margin: 0; color: var(--n-7); font-size: var(--text-copy-13); }
  .project-tech { margin: 22px 0 0; color: var(--n-7); font-family: var(--font-mono); font-size: var(--text-label-12); text-transform: uppercase; }
  @media (max-width: 520px) {
    .project-item { grid-template-columns: minmax(0, 1fr); min-height: 200px; }
    .project-number { display: none; }
  }
</style>
