---
import { withBase } from '../lib/url';
---

<dialog class="search-dialog" aria-labelledby="search-title" data-index-url={withBase('search-index.json')}>
  <div class="search-panel">
    <div class="search-topline">
      <h2 id="search-title">搜索档案</h2>
    </div>
    <label class="search-field">
      <span class="sr-only">搜索文章、随记与项目</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"></circle><path d="m15.5 15.5 4.2 4.2"></path></svg>
      <input type="search" placeholder="输入标题、正文或标签…" autocomplete="off" />
    </label>
    <div class="search-empty">
      <div class="search-tags-heading">
        <p>常用标签</p>
        <button class="search-tags-toggle" type="button" aria-expanded="false" hidden>
          <span>展开</span>
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"></path></svg>
        </button>
      </div>
      <div class="search-tags" aria-label="常用标签" data-expanded="false"></div>
    </div>
    <p class="search-status" aria-live="polite" hidden></p>
    <ol class="search-results"></ol>
    <p class="search-hint"><kbd>↑</kbd><kbd>↓</kbd> 选择　<kbd>Enter</kbd> 打开　<kbd>Esc</kbd> 关闭</p>
  </div>
</dialog>

<script>
  type SearchItem = { type: string; title: string; date: string; url: string; tags: string[]; text: string };
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog');
  const input = dialog?.querySelector<HTMLInputElement>('input');
  const results = dialog?.querySelector<HTMLOListElement>('.search-results');
  const status = dialog?.querySelector<HTMLElement>('.search-status');
  const empty = dialog?.querySelector<HTMLElement>('.search-empty');
  const tags = dialog?.querySelector<HTMLElement>('.search-tags');
  const tagsToggle = dialog?.querySelector<HTMLButtonElement>('.search-tags-toggle');
  let index: SearchItem[] | null = null;
  let active = -1;

  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;',
  })[char] || char);

  function highlightHtml(value: string, terms: string[]) {
    if (!terms.length) return escapeHtml(value);
    const normalized = value.toLocaleLowerCase();
    const ranges: Array<[number, number]> = [];

    terms.forEach((term) => {
      let offset = 0;
      while (term && offset < normalized.length) {
        const start = normalized.indexOf(term, offset);
        if (start === -1) break;
        ranges.push([start, start + term.length]);
        offset = start + term.length;
      }
    });

    if (!ranges.length) return escapeHtml(value);
    ranges.sort(([startA], [startB]) => startA - startB);
    const merged = ranges.reduce<Array<[number, number]>>((result, range) => {
      const previous = result.at(-1);
      if (previous && range[0] <= previous[1]) previous[1] = Math.max(previous[1], range[1]);
      else result.push([...range]);
      return result;
    }, []);

    let cursor = 0;
    return merged.map(([start, end]) => {
      const before = escapeHtml(value.slice(cursor, start));
      const match = `<mark>${escapeHtml(value.slice(start, end))}</mark>`;
      cursor = end;
      return before + match;
    }).join('') + escapeHtml(value.slice(cursor));
  }

  function excerpt(value: string, terms: string[], maxLength = 116) {
    const normalized = value.toLocaleLowerCase();
    const firstMatch = terms.reduce((nearest, term) => {
      const position = normalized.indexOf(term);
      return position === -1 ? nearest : Math.min(nearest, position);
    }, Number.POSITIVE_INFINITY);
    const center = Number.isFinite(firstMatch) ? firstMatch : 0;
    const start = Math.max(0, center - 28);
    const end = Math.min(value.length, start + maxLength);
    return `${start > 0 ? '…' : ''}${value.slice(start, end)}${end < value.length ? '…' : ''}`;
  }

  async function loadIndex() {
    if (index || !dialog) return;
    const response = await fetch(dialog.dataset.indexUrl || 'search-index.json');
    index = await response.json();
    renderPopularTags();
  }

  function renderPopularTags() {
    if (!tags || !index) return;
    const frequencies = new Map<string, number>();
    index.forEach((item) => new Set(item.tags).forEach((tag) => frequencies.set(tag, (frequencies.get(tag) || 0) + 1)));
    const popular = [...frequencies.entries()]
      .sort(([tagA, countA], [tagB, countB]) => countB - countA || tagA.localeCompare(tagB, 'zh-CN'))
      .slice(0, 10);
    tags.innerHTML = popular.map(([tag, count]) => `<button type="button" data-search-tag="${escapeHtml(tag)}" aria-label="搜索标签 ${escapeHtml(tag)}，${count} 条内容"><span>#${escapeHtml(tag)}</span><small>${count}</small></button>`).join('');
    setTagsExpanded(false);
    requestAnimationFrame(() => {
      if (tagsToggle) tagsToggle.hidden = tags.scrollWidth <= tags.clientWidth + 1;
    });
  }

  function setTagsExpanded(expanded: boolean) {
    if (!tags || !tagsToggle) return;
    tags.dataset.expanded = String(expanded);
    tagsToggle.ariaExpanded = String(expanded);
    const label = tagsToggle.querySelector('span');
    if (label) label.textContent = expanded ? '收起' : '展开';
  }

  async function openSearch() {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    await loadIndex();
    render(input?.value.trim() || '');
    input?.focus();
  }

  function closeSearch() {
    dialog?.close();
  }

  function render(query: string) {
    if (!results || !status || !empty || !index) return;
    const terms = query.toLocaleLowerCase().split(/\s+/).filter(Boolean);
    active = -1;
    if (!terms.length) {
      results.innerHTML = '';
      status.hidden = true;
      empty.hidden = false;
      return;
    }

    empty.hidden = true;
    status.hidden = false;

    const matches = index.map((item) => {
      const title = item.title.toLocaleLowerCase();
      const tags = item.tags.join(' ').toLocaleLowerCase();
      const text = item.text.toLocaleLowerCase();
      const score = terms.reduce((sum, term) => sum + (title.includes(term) ? 8 : 0) + (tags.includes(term) ? 4 : 0) + (text.includes(term) ? 1 : 0), 0);
      return { item, score };
    }).filter(({ score }) => score > 0).sort((a, b) => b.score - a.score).slice(0, 12);

    status.textContent = matches.length ? `找到 ${matches.length} 条结果` : '没有找到匹配内容';
    results.innerHTML = matches.map(({ item }) => {
      const label = item.type === 'post' ? '文章' : item.type === 'note' ? '随记' : '项目';
      const matchedTags = [...new Set(item.tags)].filter((tag) => terms.some((term) => tag.toLocaleLowerCase().includes(term))).slice(0, 2);
      const tagMeta = matchedTags.length ? ` · ${matchedTags.map((tag) => `#${highlightHtml(tag, terms)}`).join(' ')}` : '';
      return `<li><a href="${escapeHtml(item.url)}"><span class="result-meta">${label} · ${escapeHtml(item.date)}${tagMeta}</span><strong>${highlightHtml(item.title, terms)}</strong><span class="result-text">${highlightHtml(excerpt(item.text, terms), terms)}</span></a></li>`;
    }).join('');
  }

  document.querySelectorAll('.search-trigger').forEach((trigger) => trigger.addEventListener('click', openSearch));
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeSearch(); });
  dialog?.addEventListener('close', () => {
    if (input) input.value = '';
    setTagsExpanded(false);
    render('');
  });
  tagsToggle?.addEventListener('click', () => setTagsExpanded(tagsToggle.ariaExpanded !== 'true'));
  tags?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-search-tag]');
    if (!button || !input) return;
    input.value = button.dataset.searchTag || '';
    render(input.value);
    input.focus();
  });
  input?.addEventListener('input', () => render(input.value.trim()));
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
      return;
    }
    if (!dialog?.open || !results) return;
    const links = [...results.querySelectorAll<HTMLAnchorElement>('a')];
    if (event.key === 'Escape') closeSearch();
    if (event.key === 'ArrowDown' && links.length) { event.preventDefault(); active = (active + 1) % links.length; links[active].focus(); }
    if (event.key === 'ArrowUp' && links.length) { event.preventDefault(); active = (active - 1 + links.length) % links.length; links[active].focus(); }
  });
</script>

<style>
  .search-dialog { inset: calc(var(--header-height) + var(--space-4)) 0 auto; width: min(calc(100% - 32px), 760px); max-height: min(calc(100dvh - var(--header-height) - 40px), 640px); margin: 0 auto; padding: 0; overflow: hidden; border: 1px solid color-mix(in srgb, var(--color-icon) 30%, transparent); border-radius: var(--radius-xl); color: var(--color-text-primary); background: var(--color-bg-raised); box-shadow: var(--shadow-overlay); }
  .search-dialog[open] { animation: search-enter var(--duration-base) var(--ease-standard) both; }
  .search-dialog::backdrop { background: var(--color-overlay); }
  .search-panel { display: flex; max-height: min(calc(100dvh - var(--header-height) - 40px), 640px); padding: 18px 20px 16px; flex-direction: column; }
  .search-topline { display: flex; align-items: center; margin-bottom: 12px; }
  .search-topline h2 { margin: 0 auto 0 0; color: var(--color-text-strong-secondary); font-family: var(--font-mono); font-size: var(--text-label-12); font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  .search-field { display: flex; align-items: center; border: 1px solid color-mix(in srgb, var(--color-icon) 34%, transparent); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--color-bg-subtle) 70%, transparent); transition: border-color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard), background var(--duration-fast) var(--ease-standard); }
  .search-field:focus-within { border-color: var(--color-accent); background: var(--color-bg-raised); box-shadow: 0 0 0 3px var(--color-focus-ring); }
  .search-field svg { flex: none; width: 18px; height: 18px; margin-left: 15px; color: var(--n-7); fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.6; }
  .search-field input { min-width: 0; width: 100%; padding: 12px 15px 12px 11px; border: 0; outline: 0; color: var(--color-text-heading); background: transparent; font-family: var(--font-sans); font-size: var(--text-copy-15); line-height: var(--text-copy-15--line-height); }
  .search-field input::placeholder { color: var(--n-7); }
  .search-empty { min-width: 0; padding: 14px 0 2px; }
  .search-tags-heading { display: flex; align-items: center; justify-content: space-between; min-height: 24px; margin-bottom: 8px; }
  .search-tags-heading > p, .search-status { margin: 0; color: var(--n-7); font-family: var(--font-mono); font-size: var(--text-label-12); letter-spacing: .04em; }
  .search-tags-toggle { display: inline-flex; min-height: 24px; padding: 2px 4px 2px 7px; align-items: center; gap: 2px; border: 0; border-radius: var(--radius-sm); color: var(--color-text-secondary); background: transparent; font-family: var(--font-sans); font-size: var(--text-label-12); cursor: pointer; }
  .search-tags-toggle:hover { color: var(--color-text-heading); background: var(--color-bg-subtle); }
  .search-tags-toggle svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.4; transition: transform var(--duration-fast) var(--ease-standard); }
  .search-tags-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .search-tags { display: flex; max-width: 100%; max-height: 35px; padding: 1px 1px 5px; overflow: hidden; flex-wrap: nowrap; gap: 8px; mask-image: linear-gradient(to right, black 0, black calc(100% - 28px), transparent 100%); }
  .search-tags[data-expanded='true'] { max-height: 112px; padding-right: 4px; overflow-y: auto; flex-wrap: wrap; mask-image: none; }
  .search-tags :global(button) { display: inline-flex; flex: none; min-height: 30px; padding: 4px 9px; align-items: center; gap: 7px; border: 1px solid color-mix(in srgb, var(--color-icon) 30%, transparent); border-radius: var(--radius-md); color: var(--color-text-strong-secondary); background: color-mix(in srgb, var(--color-bg-hover) 64%, transparent); font-family: var(--font-sans); font-size: var(--text-label-12); cursor: pointer; transition: border-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard), background var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-standard); }
  .search-tags :global(button:hover), .search-tags :global(button:focus-visible) { border-color: var(--color-border-interactive); color: var(--color-text-interactive); background: var(--color-bg-interactive); transform: translateY(-1px); }
  .search-tags :global(small) { color: var(--n-7); font-family: var(--font-mono); font-size: var(--text-caption-10); }
  .search-status { margin-top: 16px; }
  .search-results { min-height: 0; max-height: 452px; margin: 0 -8px; padding: 0 8px; overflow: auto; list-style: none; }
  .search-results :global(li + li) { border-top: 1px solid var(--ring); }
  .search-results :global(a) { display: grid; gap: 2px; padding: 13px 8px; border-radius: 6px; text-decoration: none; }
  .search-results :global(a:hover), .search-results :global(a:focus) { background: var(--color-bg-interactive); outline-offset: -2px; }
  .search-results :global(a:hover strong), .search-results :global(a:focus strong) { color: var(--color-text-interactive); }
  .search-results :global(.result-meta) { color: var(--ume-ink); font-family: var(--font-mono); font-size: var(--text-caption-10); letter-spacing: .06em; }
  .search-results :global(strong) { font-family: var(--font-serif); font-size: var(--text-copy-16); font-weight: 500; }
  .search-results :global(.result-text) { color: var(--n-7); font-size: var(--text-label-12); }
  .search-results :global(mark) { padding: .01em .12em; border-radius: var(--radius-sm); color: inherit; background: var(--color-search-highlight); box-shadow: inset 0 -1px 0 var(--color-search-highlight-edge); font-weight: inherit; }
  .search-hint { margin: 14px 0 0; color: var(--n-7); font-family: var(--font-mono); font-size: var(--text-label-12); text-align: center; }
  kbd { padding: 1px 4px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-subtle); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @keyframes search-enter { from { transform: translateY(8px) scale(.99); } to { transform: translateY(0) scale(1); } }
  @media (max-width: 560px) {
    .search-dialog { inset: calc(var(--header-height) + var(--space-3)) 0 auto; width: min(calc(100% - 20px), 760px); max-height: calc(100dvh - var(--header-height) - 28px); }
    .search-panel { max-height: calc(100dvh - var(--header-height) - 28px); padding: 16px; }
    .search-hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-dialog[open] { animation: none; }
  }
</style>
