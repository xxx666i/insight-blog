---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { formatDate, getNotes, getPosts, getProjects, uniqueTags } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const [posts, notes, projects] = await Promise.all([getPosts(), getNotes(), getProjects()]);
  return uniqueTags([...posts, ...notes, ...projects]).map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const [posts, notes, projects] = await Promise.all([getPosts(), getNotes(), getProjects()]);
const items = [
  ...posts.filter((item) => item.data.tags.includes(tag)).map((entry) => ({ entry, type: '文章', href: `posts/${entry.id}/`, title: entry.data.title, text: entry.data.description })),
  ...notes.filter((item) => item.data.tags.includes(tag)).map((entry) => ({ entry, type: '随记', href: `notes/${entry.id}/`, title: entry.data.title ?? '无题随记', text: entry.body ?? '' })),
  ...projects.filter((item) => item.data.tags.includes(tag)).map((entry) => ({ entry, type: '项目', href: `projects/${entry.id}/`, title: entry.data.title, text: entry.data.summary })),
].sort((a, b) => b.entry.data.publishedAt.valueOf() - a.entry.data.publishedAt.valueOf());
const tags = uniqueTags([...posts, ...notes, ...projects]);
---

<BaseLayout title={`标签：${tag}`} description={`浏览标签“${tag}”下的内容。`}>
  <div class="page-shell page-main tag-page">
    <p class="eyebrow">Tag archive</p>
    <h1 class="page-title">#{tag}</h1>
    <p class="page-deck">共 {items.length} 条内容。</p>
    <div class="tag-switcher"><a class="tag all-tags" href={withBase('tags/')}>全部</a><TagList tags={tags} current={tag} /></div>
    <section class="tag-results" aria-label={`${tag} 标签内容`}>
      {items.map((item, index) => (
        <article class="tag-result">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><p>{item.type} · {formatDate(item.entry.data.publishedAt)}</p><h2><a href={withBase(item.href)}>{item.title}</a></h2><p>{item.text.slice(0, 130)}</p></div>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .tag-page { max-width: 940px; }
  .tag-switcher { display: flex; align-items: flex-start; gap: var(--space-2); margin-top: var(--space-12); padding-bottom: var(--space-6); border-bottom: 1px solid var(--color-border); }
  .tag-switcher :global(.tag-list) { gap: var(--space-2); }
  .tag-switcher :global(.tag) { min-height: var(--space-8); padding: var(--space-1) 10px; color: var(--color-text-strong-secondary); background: var(--color-bg-raised); font-size: var(--text-copy-13); line-height: var(--text-copy-13--line-height); }
  .all-tags { flex: none; }
  .tag-result { position: relative; display: grid; grid-template-columns: 34px minmax(0,1fr); gap: var(--space-5); padding: 28px var(--space-3); margin-inline: calc(var(--space-3) * -1); border-bottom: 1px solid var(--color-border); border-radius: var(--radius-md); transition: background var(--duration-fast) var(--ease-standard); }
  .tag-result:hover { background: var(--color-bg-interactive); }
  .tag-result > span { padding-top: 2px; color: var(--color-text-secondary); font-family: var(--font-mono); font-size: var(--text-label-12); font-weight: 500; line-height: var(--text-label-12--line-height); }
  .tag-result > div > p:first-child { margin: 0; color: var(--color-text-strong-secondary); font-family: var(--font-mono); font-size: var(--text-label-12); font-weight: 500; line-height: var(--text-label-12--line-height); }
  .tag-results h2 { margin: var(--space-1) 0; color: var(--color-text-heading); font-family: var(--font-serif); font-size: var(--text-title-20); font-weight: 500; line-height: var(--text-title-20--line-height); }
  .tag-results h2 a { text-decoration: none; transition: color var(--duration-fast) var(--ease-standard); }
  .tag-results h2 a::after { position: absolute; inset: 0; content: ''; }
  .tag-results h2 a:focus-visible { outline: 0; }
  .tag-result:hover h2 a, .tag-results h2 a:focus-visible { color: var(--color-text-interactive); }
  .tag-result:has(h2 a:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .tag-result > div > p:last-child { margin: 0; color: var(--color-text-strong-secondary); font-size: var(--text-copy-14); line-height: var(--text-copy-14--line-height); }
  @media (max-width: 560px) { .tag-result { grid-template-columns: 1fr; } .tag-result > span { display: none; } }
</style>
