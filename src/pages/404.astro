---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="没有找到页面" noindex>
  <div class="page-shell page-main not-found">
    <p class="eyebrow">Error / 404</p>
    <h1 class="page-title">这里暂时没有内容。</h1>
    <p>链接可能已经改变，也可能只是多走了一小段路。</p>
    <a href={withBase('/')}>回到首页</a>
  </div>
</BaseLayout>

<style>
  .not-found { min-height: 68vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .not-found > p:not(.eyebrow) { color: var(--n-6); }
  .not-found > a { display: inline-flex; min-height: 36px; margin-top: var(--space-5); padding: var(--space-2) var(--space-3); align-items: center; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-accent-ink); background: var(--color-bg-raised); font-family: var(--font-mono); font-size: var(--text-label-12); text-decoration: none; transition: border-color var(--duration-fast) var(--ease-standard), background var(--duration-fast) var(--ease-standard); }
  .not-found > a:hover { border-color: var(--color-border-interactive); color: var(--color-text-interactive); background: var(--color-bg-interactive); }
</style>
