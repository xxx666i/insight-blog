---
import { render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Callout from '../../components/Callout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, readingMinutes, relatedPosts } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const posts = await getPosts();
const { Content, headings } = await render(post);
const index = posts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index < posts.length - 1 ? posts[index + 1] : undefined;
const related = relatedPosts(post, posts);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  kind="文章"
  backHref="posts/"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={post.data.tags}
  headings={headings}
  readingTime={readingMinutes(post.body)}
  image={withBase(`og/post-${post.id}.png`)}
  math={post.data.math}
  mermaid={post.data.mermaid}
  draft={post.data.draft}
>
  <Content components={{ Callout }} />

  <Fragment slot="after">
    <footer class="post-footer page-shell">
      {post.data.codeLicense && <p class="code-license">本文代码示例许可：{post.data.codeLicense}</p>}
      {(newer || older) && (
        <nav class:list={['post-pagination', { 'single-post': !newer || !older }]} aria-label="相邻文章">
          {newer && (
            <a class="previous-post" href={withBase(`posts/${newer.id}/`)}>
              <span class="pagination-label"><span class="pagination-arrow" aria-hidden="true">←</span>上一篇</span>
              <strong>{newer.data.title}</strong>
            </a>
          )}
          {older && (
            <a class="next-post" href={withBase(`posts/${older.id}/`)}>
              <span class="pagination-label">下一篇<span class="pagination-arrow" aria-hidden="true">→</span></span>
              <strong>{older.data.title}</strong>
            </a>
          )}
        </nav>
      )}
      {related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <div class="section-heading"><h2 id="related-title" class="section-title">继续阅读</h2><span>BY SHARED TAGS</span></div>
          {related.map((item, relatedIndex) => <PostRow post={item} index={relatedIndex} />)}
        </section>
      )}
    </footer>
  </Fragment>
</ArticleLayout>

<style>
  .post-footer { display: grid; grid-template-columns: minmax(0, 1fr) var(--article-sidebar-width); column-gap: var(--article-column-gap); max-width: 1120px; margin-top: var(--space-20); }
  .post-footer > * { grid-column: 1; }
  .code-license { padding: 13px 0; border-block: 1px solid var(--ring); color: var(--n-7); font-family: var(--font-mono); font-size: var(--text-caption-10); }
  .post-pagination { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin-top: var(--space-12); }
  .post-pagination.single-post { grid-template-columns: minmax(0, 1fr); }
  .post-pagination > a { display: grid; min-height: 124px; padding: var(--space-5) var(--space-6); align-content: space-between; border: 1px solid var(--color-border); border-radius: var(--radius-lg); color: var(--color-text-heading); background: var(--color-bg-raised); text-decoration: none; transition: border-color var(--duration-fast) var(--ease-standard), background var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-standard); }
  .post-pagination > a:hover { border-color: var(--color-border-interactive); color: var(--color-text-interactive); background: var(--color-bg-interactive); box-shadow: var(--shadow-whisper); transform: translateY(-2px); }
  .post-pagination > a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .pagination-label { display: flex; margin-bottom: var(--space-5); align-items: center; gap: var(--space-2); color: var(--color-text-muted); font-family: var(--font-mono); font-size: var(--text-caption-10); letter-spacing: .08em; line-height: 1.5; text-transform: uppercase; }
  .pagination-arrow { color: var(--color-accent); font-size: var(--text-copy-13); transition: transform var(--duration-fast) var(--ease-standard); }
  .post-pagination strong { color: inherit; font-family: var(--font-serif); font-size: var(--text-title-20); font-weight: 400; line-height: 1.5; text-wrap: balance; }
  .previous-post:hover .pagination-arrow { transform: translateX(-3px); }
  .next-post { text-align: right; }
  .next-post .pagination-label { justify-content: flex-end; }
  .next-post:hover .pagination-arrow { transform: translateX(3px); }
  .related { margin-top: 84px; }
  .related .section-heading > span { color: var(--n-6); font-family: var(--font-mono); font-size: var(--text-caption-10); letter-spacing: .08em; }
  @media (max-width: 980px) { .post-footer { display: block; max-width: var(--article-content-width); } }
  @media (max-width: 600px) { .post-pagination { grid-template-columns: 1fr; } .next-post { text-align: left; } .next-post .pagination-label { justify-content: flex-start; } }
</style>
