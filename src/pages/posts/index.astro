---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import TagList from '../../components/TagList.astro';
import { getPosts, uniqueTags } from '../../lib/content';

const posts = await getPosts();
const tags = uniqueTags(posts);
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))];
---

<BaseLayout title="文章" description="Xiaoxin 的长篇文章与写作档案。">
  <div class="page-shell page-main">
    <header class="archive-header" data-enter>
      <div>
        <p class="eyebrow">Writing archive</p>
        <h1 class="page-title">文章</h1>
        <p class="page-deck">把值得反复查看的思考写完整。按年份归档，也可以从标签进入。</p>
      </div>
      <p class="archive-count"><strong>{posts.length}</strong><span>篇公开文章</span></p>
    </header>
    {tags.length > 0 && <div class="tag-filter"><span>FILTER</span><TagList tags={tags} /></div>}
    <div class="year-groups">
      {years.map((year) => (
        <section class="year-group" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <div>{posts.filter((post) => post.data.publishedAt.getFullYear() === year).map((post, index) => <PostRow post={post} index={index} />)}</div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .archive-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; padding-bottom: 50px; border-bottom: 1px solid var(--ring); }
  .archive-count { display: flex; flex-direction: column; margin: 0; color: var(--n-5); font-family: var(--font-mono); font-size: 10px; text-align: right; }
  .archive-count strong { color: var(--n-10); font-family: var(--font-serif); font-size: 44px; font-weight: 500; line-height: 1; }
  .tag-filter { display: flex; align-items: flex-start; gap: 22px; padding: 25px 0; border-bottom: 1px solid var(--ring); }
  .tag-filter > span { padding-top: 9px; color: var(--n-4); font-family: var(--font-mono); font-size: 8px; letter-spacing: .1em; }
  .year-group { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 28px; padding-top: 60px; }
  .year-group h2 { position: sticky; top: calc(var(--header-height) + 24px); align-self: start; margin: 0; color: var(--n-4); font-family: var(--font-serif); font-size: 28px; font-weight: 400; }
  @media (max-width: 620px) {
    .archive-header { align-items: flex-start; }
    .archive-count { display: none; }
    .year-group { grid-template-columns: 1fr; gap: 5px; }
    .year-group h2 { position: static; padding-bottom: 8px; border-bottom: 1px solid var(--ring); }
  }
</style>
