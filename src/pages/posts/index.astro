---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveHeader from '../../components/ArchiveHeader.astro';
import PostRow from '../../components/PostRow.astro';
import TagList from '../../components/TagList.astro';
import { getPosts, uniqueTags } from '../../lib/content';

const posts = await getPosts();
const tags = uniqueTags(posts);
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))];
---

<BaseLayout title="文章" description="Xiaoxin 的长篇文章与写作档案。">
  <div class="page-shell page-main posts-page">
    <ArchiveHeader
      eyebrow="Writing archive"
      title="文章"
      description="把值得反复查看的思考写完整。按年份归档，也可以从标签进入。"
      count={posts.length}
      countUnit="篇"
    />
    {tags.length > 0 && <div class="tag-filter"><span>FILTER</span><TagList tags={tags} /></div>}
    <div class="year-groups">
      {years.map((year) => {
        const yearPosts = posts.filter((post) => post.data.publishedAt.getFullYear() === year);
        return (
          <section class="year-group" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`}>{year}</h2>
            <div class:list={['post-timeline', { 'has-sequence': yearPosts.length > 1 }]}>
              {yearPosts.map((post, index) => (
                <PostRow post={post} index={index} timeline dateTimeline continues={index < yearPosts.length - 1} />
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .posts-page { max-width: 1120px; }
  .tag-filter { display: flex; align-items: flex-start; gap: 22px; padding: 25px 0; border-bottom: 1px solid var(--ring); }
  .tag-filter > span { padding-top: var(--space-2); color: var(--color-text-strong-secondary); font-family: var(--font-mono); font-size: var(--text-label-12); font-weight: 600; letter-spacing: .08em; line-height: var(--text-label-12--line-height); }
  .year-group { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 18px; padding-top: 60px; }
  .year-group h2 { position: sticky; top: calc(var(--header-height) + 24px); align-self: start; margin: 0; color: var(--n-7); font-family: var(--font-serif); font-size: var(--text-title-28); font-weight: 400; }
  @media (max-width: 620px) {
    .year-group { grid-template-columns: 1fr; gap: 5px; }
    .year-group h2 { position: static; padding-bottom: 8px; border-bottom: 1px solid var(--ring); }
  }
</style>
