---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import { projectStatus } from '../../config';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const statuses = ['in-progress', 'completed', 'archived'] as const;
---

<BaseLayout title="项目" description="Xiaoxin 的项目、实验与案例记录。">
  <div class="page-shell page-main">
    <header class="projects-header" data-enter>
      <p class="eyebrow">Selected work & experiments</p>
      <h1 class="page-title">项目</h1>
      <p class="page-deck">不只陈列结果，也记录问题、取舍和后来真正学到的东西。</p>
    </header>
    <div class="project-groups">
      {statuses.map((status) => {
        const items = projects.filter((project) => project.data.status === status);
        if (!items.length) return null;
        return (
          <section aria-labelledby={`status-${status}`}>
            <div class="section-heading status-heading">
              <h2 id={`status-${status}`} class="section-title">{projectStatus[status]}</h2>
              <span>{String(items.length).padStart(2, '0')}</span>
            </div>
            <div class="project-grid">{items.map((project, index) => <ProjectItem project={project} index={index} />)}</div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .projects-header { max-width: 720px; }
  .project-groups { display: grid; gap: 72px; margin-top: 76px; }
  .status-heading > span { color: var(--n-6); font-family: var(--font-mono); font-size: var(--text-caption-10); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 24px; }
  @media (max-width: 760px) { .project-grid { grid-template-columns: 1fr; } }
</style>
