---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveHeader from '../../components/ArchiveHeader.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import { projectStatus } from '../../config';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const statuses = ['in-progress', 'completed', 'archived'] as const;
---

<BaseLayout title="项目" description="Xiaoxin 的项目、实验与案例记录。">
  <div class="page-shell page-main projects-page">
    <ArchiveHeader
      eyebrow="Selected work & experiments"
      title="项目"
      description="不只陈列结果，也记录问题、取舍和后来真正学到的东西。"
      count={projects.length}
      countUnit="个"
    />
    <div class="project-groups">
      {statuses.map((status) => {
        const items = projects.filter((project) => project.data.status === status);
        if (!items.length) return null;
        return (
          <section aria-labelledby={`status-${status}`}>
            <div class="section-heading status-heading">
              <div class="status-title-line">
                <h2 id={`status-${status}`} class="section-title">{projectStatus[status]}</h2>
                <span class="status-count">共 <strong>{items.length}</strong> 个</span>
              </div>
            </div>
            <div class="project-grid">{items.map((project, index) => <ProjectItem project={project} index={index} />)}</div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page { max-width: 1120px; }
  .project-groups { display: grid; gap: 72px; margin-top: var(--space-16); }
  .status-title-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); }
  .status-count { color: var(--color-text-secondary); font-size: var(--text-copy-13); line-height: var(--text-copy-13--line-height); white-space: nowrap; }
  .status-count strong { color: var(--color-text-strong-secondary); font-weight: 500; font-variant-numeric: tabular-nums; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 24px; }
  @media (max-width: 760px) { .project-grid { grid-template-columns: 1fr; } }
</style>
