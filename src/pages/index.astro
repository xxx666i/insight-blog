---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import NoteItem from '../components/NoteItem.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { siteConfig } from '../config';
import { getNotes, getPosts, getProjects } from '../lib/content';
import { withBase } from '../lib/url';

const [posts, notes, projects] = await Promise.all([getPosts(), getNotes(), getProjects()]);
const selectedProjects = projects.filter((project) => project.data.featured).slice(0, 2);
---

<BaseLayout>
  <div class="page-shell home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-index" data-enter style="--enter-index: 0">
        <span>INDEX / 001</span>
        <span>SHANGHAI · CN</span>
      </div>
      <div class="hero-copy" data-enter style="--enter-index: 1">
        <p class="eyebrow">Personal archive</p>
        <h1 id="hero-title" class="display-title">DuDuLu<span class="title-dot">.</span></h1>
        <p class="hero-subtitle">{siteConfig.subtitle}</p>
        <p class="hero-note">以文章保存完整的思考，以随记留下正在发生的片段，也用项目记录一次次把想法做成东西的过程。</p>
      </div>
      <div class="avatar-column" data-enter style="--enter-index: 2">
        <div class="avatar-slot" aria-label="头像预留位置">
          {siteConfig.avatar ? <img src={siteConfig.avatar} alt="DuDuLu 的头像" /> : <span>头像<br />待更新</span>}
        </div>
        <span class="avatar-caption">PORTRAIT / RESERVED</span>
      </div>
      <a class="hero-scroll" href="#recent-posts" aria-label="查看最近文章"><span></span>SCROLL</a>
    </section>

    <section class="home-section" id="recent-posts" data-enter style="--enter-index: 2">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / Writing</p>
          <h2 class="section-title">最近文章</h2>
        </div>
        <a class="section-link" href={withBase('posts/')}>全部文章 ↗</a>
      </div>
      <div class="post-list">
        {posts.slice(0, 3).map((post, index) => <PostRow post={post} index={index} />)}
        {!posts.length && <p class="empty-state">文章正在整理中。</p>}
      </div>
    </section>

    <section class="home-section notes-section" data-enter style="--enter-index: 3">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / Notes</p>
          <h2 class="section-title">近期随记</h2>
        </div>
        <a class="section-link" href={withBase('notes/')}>全部随记 ↗</a>
      </div>
      {notes.slice(0, 3).map((note) => <NoteItem note={note} compact />)}
      {!notes.length && <p class="empty-state">随记正在整理中。</p>}
    </section>

    <section class="home-section" data-enter style="--enter-index: 4">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / Selected work</p>
          <h2 class="section-title">选择的项目</h2>
        </div>
        <a class="section-link" href={withBase('projects/')}>项目档案 ↗</a>
      </div>
      <div class="project-grid">
        {selectedProjects.map((project, index) => <ProjectItem project={project} index={index} />)}
      </div>
      {!selectedProjects.length && <p class="empty-state">项目正在整理中。</p>}
    </section>
  </div>
</BaseLayout>

<style>
  .home-page { overflow: hidden; }
  .hero { position: relative; display: grid; grid-template-columns: 120px minmax(0, 1fr) 180px; min-height: calc(100vh - var(--header-height)); padding: clamp(70px, 11vh, 126px) 0 88px; align-items: center; gap: clamp(30px, 6vw, 84px); }
  .hero::after { position: absolute; right: 0; bottom: 45px; left: 0; height: 1px; background: var(--ring); content: ''; }
  .hero-index { align-self: start; display: flex; flex-direction: column; gap: 7px; padding-top: 13px; color: var(--n-4); font-family: var(--font-mono); font-size: 9px; letter-spacing: .08em; writing-mode: vertical-rl; }
  .title-dot { color: var(--ume); }
  .hero-subtitle { margin: 28px 0 0; color: var(--n-8); font-family: var(--font-serif); font-size: clamp(20px, 2.4vw, 28px); letter-spacing: .02em; }
  .hero-note { max-width: 560px; margin: 28px 0 0; padding-left: 20px; border-left: 1px solid var(--ume); color: var(--n-6); font-size: 14px; }
  .avatar-column { align-self: start; justify-self: end; padding-top: 6vh; }
  .avatar-slot { position: relative; display: grid; width: 68px; height: 68px; margin-left: auto; place-items: center; overflow: hidden; border: 1px solid var(--n-3); border-radius: 50%; color: var(--n-5); background: var(--n-1); font-family: var(--font-mono); font-size: 8px; line-height: 1.45; text-align: center; }
  .avatar-slot::after { position: absolute; right: 8px; bottom: 7px; width: 5px; height: 5px; border: 2px solid var(--paper); border-radius: 50%; background: var(--ume); content: ''; box-sizing: content-box; }
  .avatar-slot img { width: 100%; height: 100%; object-fit: cover; }
  .avatar-caption { display: block; margin-top: 11px; color: var(--n-4); font-family: var(--font-mono); font-size: 7px; letter-spacing: .06em; white-space: nowrap; }
  .hero-scroll { position: absolute; bottom: 13px; left: 0; display: flex; align-items: center; gap: 10px; color: var(--n-5); font-family: var(--font-mono); font-size: 8px; letter-spacing: .1em; text-decoration: none; }
  .hero-scroll span { width: 26px; height: 1px; background: var(--ume); }
  .home-section { padding: clamp(78px, 11vw, 136px) 0 0; }
  .notes-section { margin-left: clamp(0px, 7vw, 84px); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 28px; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 42px minmax(0, 1fr); gap: 20px; }
    .avatar-column { position: absolute; top: 55px; right: 0; padding: 0; }
    .hero-copy { grid-column: 2; }
    .project-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero { display: block; min-height: 670px; padding-top: 98px; }
    .hero-index { display: none; }
    .avatar-column { top: 28px; }
    .avatar-caption { display: none; }
    .hero-subtitle { max-width: 250px; }
    .notes-section { margin-left: 0; }
  }
</style>
