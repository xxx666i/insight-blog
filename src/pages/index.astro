---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import NoteItem from '../components/NoteItem.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { siteConfig } from '../config';
import { getNotes, getPosts, getProjects } from '../lib/content';
import { withBase } from '../lib/url';

const [posts, notes, projects] = await Promise.all([getPosts(), getNotes(), getProjects()]);
const selectedProjects = projects.filter((project) => project.data.featured).slice(0, 2);
const totalEntries = posts.length + notes.length + projects.length;
---

<BaseLayout>
  <div class="home-page">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-atmosphere" aria-hidden="true"></div>

      <div class="hero-center">
        <p class="hero-kicker" data-enter style="--enter-index: 0">INSIGHT BLOG / PERSONAL ARCHIVE</p>
        <div class="hero-avatar" data-enter style="--enter-index: 1">
          <img src={withBase(siteConfig.avatar)} alt={`${siteConfig.author} 的头像`} width="112" height="112" />
        </div>

        <h1 id="hero-title" class="hero-title" data-enter style="--enter-index: 2">
          <span class="hero-greeting"><span class="greeting-copy">Hi, I'm</span> <span class="hero-name">{siteConfig.author}</span><span class="wave" aria-hidden="true">👋</span></span>
          <span class="hero-role"><span class="sr-only">Insight Blog — </span>A curious <span class="developer-label"><code>&lt;Developer/&gt;</code><span class="typing-caret" aria-hidden="true"></span></span></span>
        </h1>
        <p class="hero-subtitle" data-enter style="--enter-index: 3">{siteConfig.subtitle}</p>
      </div>

      <div class="hero-meta" data-enter style="--enter-index: 4">
        <blockquote>「 保持好奇，保留余白，也把每一次思考写下来。」</blockquote>
        <p class="hero-stats" aria-label="站点内容统计">
          <span>{posts.length} 篇文章</span>
          <span>{notes.length} 条随记</span>
          <span>{totalEntries} 份档案</span>
        </p>
        <nav class="hero-links" aria-label="站点与社交链接">
          <a href={siteConfig.github} aria-label="GitHub" title="GitHub" rel="me">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8a9.3 9.3 0 0 0-2.94 18.12c.47.08.64-.2.64-.45v-1.8c-2.62.57-3.17-1.11-3.17-1.11-.43-1.09-1.05-1.38-1.05-1.38-.86-.59.06-.58.06-.58.95.07 1.45.98 1.45.98.85 1.44 2.22 1.03 2.76.78.09-.61.33-1.03.6-1.27-2.09-.24-4.29-1.05-4.29-4.66 0-1.03.37-1.87.98-2.53-.1-.24-.43-1.2.09-2.5 0 0 .8-.26 2.56.97A8.9 8.9 0 0 1 12 7.05a8.9 8.9 0 0 1 2.33.31c1.77-1.23 2.56-.97 2.56-.97.52 1.3.19 2.26.09 2.5.61.66.98 1.5.98 2.53 0 3.62-2.2 4.41-4.3 4.65.34.3.64.86.64 1.74v2.66c0 .25.17.54.65.45A9.3 9.3 0 0 0 12 2.8Z"></path></svg>
          </a>
          <a href={withBase('rss.xml')} aria-label="RSS" title="RSS">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6.2" cy="17.8" r="1.4"></circle><path d="M4.8 11.2a8 8 0 0 1 8 8M4.8 6.1a13.1 13.1 0 0 1 13.1 13.1"></path></svg>
          </a>
          <a href={`mailto:${siteConfig.about.contact}`} aria-label={`邮箱：${siteConfig.about.contact}`} title={siteConfig.about.contact}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect><path d="m5 7 7 5.2L19 7"></path></svg>
          </a>
          <a href={withBase('about/')} aria-label="关于 Xiaoxin" title="关于">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.2" r="3.2"></circle><path d="M5.9 19.3c.7-3 3-4.8 6.1-4.8s5.4 1.8 6.1 4.8"></path></svg>
          </a>
        </nav>
      </div>

      <a class="hero-scroll" href="#recent-posts" aria-label="查看最近文章">
        <span>近期文章</span><i aria-hidden="true"></i>
      </a>
    </section>

    <div class="home-content page-shell">
      <section class="home-section writing-section" id="recent-posts" data-enter style="--enter-index: 1">
        <div class="section-heading">
          <div>
            <p class="section-kicker">RECENT WRITING</p>
            <h2 class="section-title">最近文章</h2>
          </div>
          <a class="section-link" href={withBase('posts/')}>全部文章 ↗</a>
        </div>
        <div class="post-list">
          {posts.slice(0, 3).map((post, index) => <PostRow post={post} index={index} />)}
          {!posts.length && <p class="empty-state">文章正在整理中。</p>}
        </div>
      </section>

      <section class="home-section notes-section" data-enter style="--enter-index: 2">
        <div class="section-heading">
          <div>
            <p class="section-kicker">MUSINGS</p>
            <h2 class="section-title">近期随记</h2>
          </div>
          <a class="section-link" href={withBase('notes/')}>全部随记 ↗</a>
        </div>
        {notes.slice(0, 3).map((note) => <NoteItem note={note} compact />)}
        {!notes.length && <p class="empty-state">随记正在整理中。</p>}
      </section>

      <section class="home-section projects-section" data-enter style="--enter-index: 3">
        <div class="section-heading">
          <div>
            <p class="section-kicker">SELECTED WORK</p>
            <h2 class="section-title">选择的项目</h2>
          </div>
          <a class="section-link" href={withBase('projects/')}>项目档案 ↗</a>
        </div>
        <div class="project-grid">
          {selectedProjects.map((project, index) => <ProjectItem project={project} index={index} />)}
        </div>
        {!selectedProjects.length && <p class="empty-state">项目正在整理中。</p>}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-page { overflow: clip; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .hero { position: relative; display: grid; min-height: calc(100svh - var(--header-height) - clamp(64px, 8vh, 84px)); padding-block: clamp(42px, 6vh, 68px) 48px; place-items: center; isolation: isolate; }
  .hero-atmosphere { position: absolute; inset: 0 50%; z-index: -1; width: 100vw; transform: translateX(-50%); overflow: hidden; background: radial-gradient(circle at 50% 36%, color-mix(in srgb, var(--paper-raised) 76%, transparent) 0 10rem, transparent 31rem), radial-gradient(circle at 22% 45%, color-mix(in srgb, var(--ume) 5%, transparent), transparent 25rem), radial-gradient(circle at 80% 30%, color-mix(in srgb, var(--n-3) 26%, transparent), transparent 28rem); }
  .hero-atmosphere::before { position: absolute; inset: 0; opacity: .28; background-image: radial-gradient(circle, color-mix(in srgb, var(--n-6) 24%, transparent) .55px, transparent .7px); background-size: 7px 7px; content: ''; mask-image: linear-gradient(to bottom, transparent, black 18%, black 78%, transparent); }
  .hero-atmosphere::after { position: absolute; inset: auto 0 0; height: 160px; background: linear-gradient(to bottom, transparent, var(--paper)); content: ''; }

  .hero-center { align-self: center; display: flex; flex-direction: column; align-items: center; text-align: center; transform: translateY(clamp(-58px, -5vh, -42px)); }
  .hero-kicker, .section-kicker { margin: 0; color: var(--n-8); font-family: var(--font-mono); font-size: var(--text-label-12); font-weight: 600; letter-spacing: .1em; line-height: 1.5; }
  .hero-kicker { order: 2; margin-top: 29px; }
  .hero-avatar { order: 1; position: relative; width: clamp(82px, 8vw, 112px); aspect-ratio: 1; padding: 5px; border: 1px solid var(--ring); border-radius: 50%; background: color-mix(in srgb, var(--paper-raised) 80%, transparent); box-shadow: 0 4px 24px color-mix(in srgb, var(--n-10) 5%, transparent); }
  .hero-avatar::after { position: absolute; right: 8%; bottom: 9%; width: 8px; height: 8px; border: 3px solid var(--paper); border-radius: 50%; background: var(--ume); content: ''; }
  .hero-avatar img { display: block; width: 100%; height: 100%; border-radius: inherit; object-fit: cover; }

  .hero-title { order: 3; display: grid; justify-items: center; gap: 2px; margin: 23px 0 0; color: var(--n-9); font-family: var(--font-sans); font-size: clamp(30px, 4vw, 49px); font-weight: 400; letter-spacing: -.025em; line-height: 1.25; text-wrap: balance; }
  .hero-greeting { font-size: .8em; letter-spacing: -.015em; white-space: nowrap; }
  .greeting-copy { letter-spacing: -.035em; }
  .hero-name { color: var(--ume); font-family: var(--font-serif); font-weight: 500; letter-spacing: -.035em; }
  .wave { display: inline-block; margin-left: .18em; transform-origin: 70% 75%; animation: wave 2.8s ease-in-out 1.1s 2; }
  .developer-label { display: inline-flex; align-items: center; margin-left: .16em; vertical-align: .08em; }
  .hero-role code { display: inline-block; padding: .08em .32em .14em; border: 1px solid color-mix(in srgb, var(--ume) 58%, var(--ring)); border-radius: 8px; color: var(--ume); background: color-mix(in srgb, var(--ume-soft) 72%, transparent); font-family: var(--font-mono); font-size: .72em; font-weight: 500; letter-spacing: -.035em; }
  .typing-caret { width: 2px; height: .78em; margin-left: 4px; background: var(--ume); box-shadow: 0 0 8px color-mix(in srgb, var(--ume) 56%, transparent); animation: caret-blink 1s steps(1, end) infinite; }
  .hero-subtitle { order: 4; margin: 18px 0 0; color: var(--n-8); font-family: var(--font-sans); font-size: var(--text-label-12); letter-spacing: .12em; line-height: 1.5; text-transform: uppercase; }

  .hero-meta { position: absolute; right: 0; bottom: 46px; left: 0; display: grid; justify-items: center; color: var(--n-8); white-space: nowrap; text-align: center; }
  .hero-meta blockquote { margin: 0; font-family: var(--font-serif); font-size: var(--text-copy-14); font-style: italic; line-height: 1.57; }
  .hero-stats { display: flex; gap: 0; margin: 8px 0 18px; color: var(--n-7); font-family: var(--font-mono); font-size: var(--text-label-12); font-variant-numeric: tabular-nums; letter-spacing: .02em; line-height: 1.5; }
  .hero-stats span + span::before { margin-inline: 10px; color: var(--n-6); content: '·'; }
  .hero-links { display: flex; gap: 12px; }
  .hero-links a { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--ring); border-radius: 50%; color: var(--n-7); background: color-mix(in srgb, var(--paper-raised) 30%, transparent); line-height: 0; text-decoration: none; transition: color 180ms ease, border-color 180ms ease, transform 180ms ease, background 180ms ease; }
  .hero-links a:hover { border-color: color-mix(in srgb, var(--ume) 45%, var(--ring)); color: var(--ume-ink); background: var(--paper-raised); transform: translateY(-2px); }
  .hero-links svg { display: block; width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
  .hero-links a:first-child svg { fill: currentColor; stroke: none; }
  .hero-scroll { position: absolute; right: 0; bottom: 20px; display: flex; align-items: center; gap: 10px; color: var(--n-8); font-family: var(--font-sans); font-size: var(--text-label-12); font-weight: 500; letter-spacing: .1em; line-height: 1.5; text-decoration: none; writing-mode: vertical-rl; }
  .hero-scroll:hover { color: var(--ume-ink); }
  .hero-scroll i { width: 1px; height: 32px; background: linear-gradient(var(--ume), transparent); }

  .home-content { display: grid; grid-template-columns: minmax(0, 7fr) minmax(340px, 5fr); padding-block: clamp(70px, 9vw, 112px) 112px; }
  .home-section { min-width: 0; }
  .writing-section { padding-right: clamp(34px, 5vw, 74px); }
  .notes-section { padding-left: clamp(34px, 5vw, 74px); border-left: 1px solid var(--ring); }
  .projects-section { grid-column: 1 / -1; margin-top: clamp(84px, 10vw, 130px); }
  .section-heading { min-height: 78px; }
  .section-kicker { margin-bottom: 10px; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 28px; }

  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(14deg); }
    50% { transform: rotate(-8deg); }
    75% { transform: rotate(12deg); }
  }

  @keyframes caret-blink {
    0%, 46% { opacity: 1; transform: translateY(0); }
    47%, 100% { opacity: 0; transform: translateY(2px); }
  }

  @media (max-height: 760px) and (min-width: 761px) {
    .hero { min-height: 680px; }
  }

  @media (max-width: 900px) {
    .home-content { grid-template-columns: 1fr; }
    .writing-section { padding-right: 0; }
    .notes-section { margin-top: 84px; padding-left: 0; border-left: 0; }
    .projects-section { grid-column: auto; margin-top: 84px; }
  }

  @media (max-width: 620px) {
    .hero { display: flex; min-height: auto; padding-block: 38px 64px; flex-direction: column; }
    .hero-center { width: 100%; align-self: stretch; transform: none; }
    .hero-title { font-size: clamp(27px, 8.5vw, 38px); }
    .hero-role { display: block; }
    .developer-label { display: flex; width: max-content; margin: 7px auto 0; }
    .hero-subtitle { max-width: 280px; }
    .hero-meta { position: static; width: 100%; margin-top: clamp(82px, 14vh, 116px); white-space: normal; }
    .hero-meta blockquote { max-width: 300px; }
    .hero-scroll { display: none; }
    .home-content { padding-block: 70px 84px; }
    .project-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 400px) {
    .hero-meta blockquote { display: none; }
    .hero-stats { margin-top: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .typing-caret { opacity: 1; animation: none; transform: none; }
  }
</style>
