---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { canonical, withBase } from '../lib/url';
import { siteConfig } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  math?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  type = 'website',
  noindex = false,
  math = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${siteConfig.name}` : `${siteConfig.name} — ${siteConfig.subtitle}`;
const canonicalUrl = canonical(Astro.url.pathname.replace(import.meta.env.BASE_URL, '/'));
const ogImage = image ?? withBase(`og/site.png`);
---

<!doctype html>
<html lang={siteConfig.lang} data-theme="light" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={withBase('rss.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, import.meta.env.SITE).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, import.meta.env.SITE).toString()} />
    <title>{pageTitle}</title>
    {math && <link rel="stylesheet" href={withBase('katex.min.css')} />}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('dudulu-theme') || 'system';
        const dark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.themePreference = saved;
        document.documentElement.dataset.theme = saved === 'system' ? (dark ? 'dark' : 'light') : saved;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
  </body>
</html>
